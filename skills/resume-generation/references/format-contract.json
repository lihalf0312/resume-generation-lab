{
  "schema_version": 1,
  "contract_kind": "sanitized_source_requirements",
  "scope": "bilingual_resume",
  "source_biography_included": false,
  "page": {
    "size": "A4",
    "width_mm": 210,
    "height_mm": 297,
    "orientation": "portrait",
    "pages_per_language": 1,
    "full_body_area": true,
    "bottom_whitespace_numeric_limit": null,
    "preserve_template_fonts_sizes_margins": true,
    "forbidden_fit_methods": [
      "unauthorized_font_shrinking",
      "cropping",
      "hidden_content",
      "filler_blank_lines",
      "inflated_font_or_line_spacing"
    ]
  },
  "paragraph_final_line": {
    "applies_to": "body_prose",
    "minimum_ratio_exclusive": 0.5,
    "preferred_ratio_inclusive": [
      0.67,
      0.8
    ],
    "measure_width": "available_line_width_after_indentation",
    "exempt": [
      "name",
      "short_heading",
      "date_field"
    ],
    "verification": "rendered"
  },
  "headings": {
    "zh": "upper_and_lower_rules",
    "en": "lower_rule"
  },
  "dates": {
    "bold_all_languages": true,
    "zh_graduation_field_bold_includes": [
      "label",
      "colon",
      "date"
    ]
  },
  "language_specific": {
    "zh": {
      "photo": "only_if_supplied_and_authorized",
      "political_content": "only_if_supplied_and_authorized"
    },
    "en": {
      "photo": "omit",
      "political_content": "omit"
    },
    "bilingual_facts": "corresponding_core_facts_allow_nonmisleading_detail_selection_differences"
  },
  "word_settings": {
    "autoSpaceDE": true,
    "autoSpaceDN": true,
    "characterSpacingControl": "doNotCompress",
    "verify_effective_inherited_settings": true,
    "manual_numeric_padding": false,
    "special_plus_sign_spacing_fix": false
  },
  "alignment": {
    "same_level_bullet_and_title_starts": "verify_rendered_positions",
    "experience_main_line": "Organization | Department-Role",
    "use_tabs_not_spaces": true
  },
  "punctuation": {
    "single_rendered_line_short_education_or_other_info": "no_terminal_full_stop",
    "multiline_prose": "do_not_remove_globally"
  },
  "english_spacing": {
    "words": "one_ASCII_space",
    "after_comma_colon_semicolon": "one_space",
    "before_comma_colon_semicolon": "none",
    "between_sentences": "one_space",
    "date_range_separator": "one_space_each_side",
    "inside_parentheses": "no_extra_spaces",
    "technical_slashes": "no_extra_spaces",
    "check_across_runs": true,
    "preserve_semantic_exceptions": [
      "times",
      "urls",
      "thousands_separators",
      "technical_names",
      "compound_words"
    ]
  },
  "delivery": {
    "formats": [
      "docx",
      "pdf"
    ],
    "pdf_source": "final_docx",
    "pdf_body_selectable_extractable": true,
    "unique_role_version_directory": true
  },
  "verification": {
    "must_render": true,
    "checks": [
      "page_size",
      "page_count",
      "body_area_utilization",
      "bottom_whitespace",
      "clipping",
      "overflow",
      "page_breaks",
      "font_fallback",
      "photo_aspect_ratio_if_present",
      "paragraph_and_module_alignment",
      "final_line_ratios",
      "evidence_and_numbers",
      "pdf_text_extraction"
    ],
    "unperformed_result": "unverified_not_passed"
  },
  "missing_template_parameters": [
    "fonts",
    "font_sizes",
    "margins",
    "tab_stops",
    "photo_geometry",
    "body_bounds",
    "bottom_whitespace_tolerance"
  ],
  "provisional_thresholds_must_be_separate": true
}
